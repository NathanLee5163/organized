# Copy to .env and fill in values from Google Cloud Console.
# See docs/SETUP.md for step-by-step instructions.

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Reversed client ID for iOS URL scheme, e.g.
# com.googleusercontent.apps.123456789-abcdef
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=todocalendar

# Set after running `eas init`
EAS_PROJECT_ID=
